#!/bin/bash
# snap/local/owldetect-launch
#
# Entry point for the `perception` daemon app (NanoOWL / Jetson variant).
# Reads the runtime.env and params.yaml rendered by the configure hook and
# execs owl_detect_node directly.
#
# Runs inside the ros2-humble extension's command-chain, so the ROS 2
# environment is already sourced and owl_detect_node is on PATH. The heavy
# lifting (building the TensorRT image-encoder engine on first run, downloading
# the OWL-ViT weights from Hugging Face into $HF_HOME) happens inside the node.
set -eu

PARAMS_FILE="$SNAP_DATA/params.yaml"
RUNTIME_ENV="$SNAP_DATA/runtime.env"
OWL_DETECT_NODE_EXE="$SNAP/opt/ros/snap/lib/ai_vision_ros2_nanoowl_demo/owl_detect_node"

export LD_LIBRARY_PATH="$SNAP/usr/lib/aarch64-linux-gnu/lapack:$SNAP/usr/lib/aarch64-linux-gnu/blas:$SNAP/usr/lib/aarch64-linux-gnu/openblas-pthread:${LD_LIBRARY_PATH:-}"

# The TensorRT python bindings install to
# usr/lib/python3.10/dist-packages/tensorrt
export PYTHONPATH="$SNAP/usr/lib/python3.10/dist-packages:${PYTHONPATH:-}"

if [ ! -f "$PARAMS_FILE" ]; then
  echo "owldetect (nvidia): no configuration found yet at $PARAMS_FILE" >&2
  echo "owldetect (nvidia): the configure hook should have created this on install" >&2
  exit 1
fi

# NAMESPACE, NODE_NAME, ROS_DOMAIN_ID, RMW_IMPLEMENTATION (all optional)
if [ -f "$RUNTIME_ENV" ]; then
  # shellcheck disable=SC1090
  . "$RUNTIME_ENV"
fi

# Disable Fast DDS shared-memory transport (force UDP-only). SHM can't cross
# strict-confinement sandboxes. Only meaningful for a Fast DDS RMW.
case "${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}" in
  rmw_fastrtps_*)
    export FASTRTPS_DEFAULT_PROFILES_FILE="$SNAP/usr/share/fastdds_no_shared_memory.xml"
    ;;
esac

# Hugging Face cache + TensorRT engine cache in $SNAP_COMMON (writable, shared
# across revisions/channels). The node downloads the OWL-ViT weights here on
# first run and builds/loads the image-encoder engine from OWL_ENGINE_DIR.
export HF_HOME="${HF_HOME:-$SNAP_COMMON/hf}"
ENGINE_DIR="${OWL_ENGINE_DIR:-$SNAP_COMMON/trt_engines}"
mkdir -p "$HF_HOME" "$ENGINE_DIR"

# Seed the bundled prebuilt engine (if any) on first run so a matching device
# skips the ~1-2 min build and gets instant TensorRT inference. -n (no-clobber)
# means a locally-rebuilt engine always wins; and owl_detect_node deletes +
# rebuilds any engine that fails to load, so a stale bundled engine is harmless.
if [ -d "$SNAP/prebuilt_engines" ]; then
  cp -an "$SNAP/prebuilt_engines/." "$ENGINE_DIR/" 2>/dev/null || true
fi

set -- "$OWL_DETECT_NODE_EXE" --ros-args --params-file "$PARAMS_FILE"

if [ -n "${NODE_NAME:-}" ]; then
  set -- "$@" -r __node:="$NODE_NAME"
fi

if [ -n "${NAMESPACE:-}" ]; then
  set -- "$@" -r __ns:="$NAMESPACE"
fi

echo "owldetect (nvidia): exec: $*" >&2
exec "$@"
